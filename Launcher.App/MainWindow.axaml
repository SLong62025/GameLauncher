<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.App.ViewModels"
        x:Class="Launcher.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Game Launcher"
        Width="1000" Height="700">

  <DockPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Games}" Margin="8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameTileViewModel">
            <Button Width="172" Margin="6" Padding="6"
                    Background="Transparent"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    Command="{Binding LaunchCommand}"
                    ToolTip.Tip="{Binding Title}">
              <StackPanel Spacing="6">
                
                <Border Width="160" Height="240" CornerRadius="6" ClipToBounds="True"
                        Background="#22808080">
                  <Grid>
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                    <TextBlock Text="No cover art" IsVisible="{Binding !HasCover}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.5" />
                  </Grid>
                </Border>

                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding StoreLabel}" FontSize="12" Opacity="0.6" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</Window>
