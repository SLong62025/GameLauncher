<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.App.ViewModels"
        x:Class="Launcher.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Game Launcher"
        Width="1000" Height="650">

  <DockPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Games}" Margin="8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameTileViewModel">
            <Border Width="200" Height="130" Margin="6" Padding="12"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="#44808080" Background="#18808080">
              <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Launch"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding LaunchCommand}" />
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StoreLabel}" FontSize="12" Opacity="0.6" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</Window>
